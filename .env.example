# Pet10x — environment
# Copy to .env.local and fill in. Anything without the NEXT_PUBLIC_ prefix stays
# server-side and is never shipped to the browser.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Enables manager/admin email invites (/api/strata/invite,
# /api/admin/invite). Supabase dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI vet assistant (Groq)
# ---------------------------------------------------------------------------
# Required. https://console.groq.com/keys — server-only, never NEXT_PUBLIC_.
# Note: Groq's free tier runs at 10–30 requests/min and 1.2K–15K tokens/min,
# which is fine locally and nowhere near enough for real traffic. The Developer
# plan is a prerequisite for anything past a demo.
GROQ_API_KEY=

# Model IDs live in env because Groq retires preview models with little notice.
# Re-check these against https://console.groq.com/docs/models before deploying.
#
#   VET_QA  — needs built-in web search. Use `compound-mini`, NOT `compound`:
#             compound makes multiple tool calls and feeds every fetched page
#             back through its own model, so on the free tier the requests that
#             actually searched died with HTTP 413 (measured 1/3 success).
#             Mini is capped at one tool call and scored 3/3, still grounded.
#   VISION  — Groq's only vision model, PREVIEW tier. Leave empty to turn photo
#             questions off; the chat degrades to text-only rather than failing.
#   TRIAGE  — runs on every message before the answer does. Must NOT be a
#             reasoning model: gpt-oss-20b spends its budget thinking before it
#             writes and returned truncated JSON (HTTP 400 every call). This one
#             answers in ~8 tokens / ~120ms and has 14.4K req/day vs 1K.
AI_MODEL_VET_QA=groq/compound-mini
AI_MODEL_VISION=qwen/qwen3.6-27b
AI_MODEL_TRIAGE=llama-3.1-8b-instant
AI_MODEL_COPY=llama-3.1-8b-instant
AI_MODEL_TITLE=llama-3.1-8b-instant

# The domains grounded answers may cite. Both are copyrighted and prohibit
# scraping — they are live retrieval targets read at answer time, never a corpus
# copied into our database. Adding a domain here is a legal decision, not a
# config tweak.
AI_GROUNDING_DOMAINS=veterinarypartner.vin.com,merckvetmanual.com

# Upstream call ceiling in ms. Compound fetches live pages mid-answer, so this
# is deliberately generous.
AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Email (Resend) — optional
# ---------------------------------------------------------------------------
RESEND_API_KEY=
NEXT_PUBLIC_BASE_URL=
