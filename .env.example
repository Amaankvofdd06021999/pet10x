# Pet10x — environment
# Copy to .env.local and fill in. Anything without the NEXT_PUBLIC_ prefix stays
# server-side and is never shipped to the browser.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Enables manager/admin email invites (/api/strata/invite,
# /api/admin/invite). Supabase dashboard > Project Settings > API > service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI vet assistant (Groq)
# ---------------------------------------------------------------------------
# Required. https://console.groq.com/keys — server-only, never NEXT_PUBLIC_.
# Note: Groq's free tier runs at 10–30 requests/min and 1.2K–15K tokens/min,
# which is fine locally and nowhere near enough for real traffic. The Developer
# plan is a prerequisite for anything past a demo.
GROQ_API_KEY=

# Model IDs live in env because Groq retires preview models with little notice.
# Re-check these against https://console.groq.com/docs/models before deploying.
#
#   VET_QA  — the owner-facing answer. Grounding (citations) only happens on a
#             `groq/compound*` model, which is the ONLY family with built-in web
#             search. On the free tier compound no longer answers at all: it
#             feeds fetched pages back through itself and Groq returns 413 when
#             one request exceeds the tier's per-minute token budget. Measured
#             2026-09-19 over 8 ordinary questions: 1 answered, 0 grounded.
#             So this is a plain model, answers are ungrounded, and the prompt
#             says so. Set it back to `groq/compound-mini` on a paid tier and
#             grounding, citations and the status copy all switch back on.
#             NOTE: plain models allow 8K tokens/min vs compound's 70K, so
#             MAX_HISTORY_TURNS and MAX_ANSWER_TOKENS in the chat route are
#             sized for 8K. Raise the tier before raising those.
#   VISION  — Groq's only vision model, PREVIEW tier. Leave empty to turn photo
#             questions off; the chat degrades to text-only rather than failing.
#   TRIAGE  — runs on every message before the answer does. Must NOT be a
#             reasoning model: gpt-oss-20b spends its budget thinking before it
#             writes and returned truncated JSON (HTTP 400 every call). This one
#             answers the classifier prompt in 6 tokens / ~150ms, no reasoning.
#
# Retired by Groq on 2026-09-18 — both now 404 model_not_found. If the assistant
# goes quiet, check this first: `curl -H "Authorization: Bearer $GROQ_API_KEY"
# https://api.groq.com/openai/v1/models` lists what the key can actually reach.
#   llama-3.1-8b-instant → qwen/qwen3.8-27b  (TRIAGE, COPY, TITLE)
#   qwen/qwen3.6-27b     → qwen/qwen3.8-27b  (VISION)
AI_MODEL_VET_QA=openai/gpt-oss-120b
AI_MODEL_VISION=qwen/qwen3.8-27b
AI_MODEL_TRIAGE=qwen/qwen3.8-27b
AI_MODEL_COPY=qwen/qwen3.8-27b
AI_MODEL_TITLE=qwen/qwen3.8-27b

# The domains grounded answers may cite. Both are copyrighted and prohibit
# scraping — they are live retrieval targets read at answer time, never a corpus
# copied into our database. Adding a domain here is a legal decision, not a
# config tweak.
AI_GROUNDING_DOMAINS=veterinarypartner.vin.com,merckvetmanual.com

# How long a photo attached to a chat is kept before the nightly sweep deletes
# it. Attachments are a rash, a wound, a vet document -- the most sensitive
# thing the app holds -- so they expire rather than accumulating. Values below
# 1 are ignored and fall back to 7, so a misconfiguration can't wipe the bucket.
AI_MEDIA_RETENTION_DAYS=7

# Guards /api/ai/media/purge and the other crons in vercel.json (including
# /api/notifications/dispatch, every 5 minutes).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
# Without it the endpoint refuses every request. Use a long random string.
CRON_SECRET=

# Upstream call ceiling in ms. Compound fetches live pages mid-answer, so this
# is deliberately generous.
AI_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------
# Email (Resend) — optional
# ---------------------------------------------------------------------------
# Without a key every email is suppressed (logged, not sent), and the
# notification dispatcher skips its email pass. Outside production emails are
# suppressed even with a key unless EMAIL_DEV_SEND=1.
RESEND_API_KEY=
# The From line. Must be on a domain verified in Resend.
EMAIL_FROM="Pet10x <noreply@pet10x.com>"
# Absolute origin used in email links (https://www.pet10x.com in production).
NEXT_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Web push (VAPID) — optional
# ---------------------------------------------------------------------------
# Generate a pair once per environment and keep it: rotating the keys silently
# invalidates every browser subscription.
#
#   npx web-push generate-vapid-keys
#
# The public key goes to the browser; the private key never leaves the server.
# VAPID_SUBJECT is a contact for push services: a mailto: or https: URL.
# With any of the three missing, /api/notifications/dispatch skips its push
# pass and the "Push on this device" switch is not shown.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@pet10x.com

# ---------------------------------------------------------------------------
# Support contact
# ---------------------------------------------------------------------------
# Printed on /terms, /privacy, /help and every "Contact support" link (lib/site.ts).
# Falls back to support@pet10x.com when unset.
NEXT_PUBLIC_SUPPORT_EMAIL=
